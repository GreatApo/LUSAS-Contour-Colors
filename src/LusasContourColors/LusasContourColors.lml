<?xml version="1.0" encoding="utf-8"?>
<modules xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" domain="Apostolos Grammatopoulos" version="1.0.0" xmlns="urn:lusas:modules:1.0">
  <module name="LusasContourColors">
    <assembly>
      <path>%ModulesMachineDir%</path>
      <file>LusasContourColors.dll</file>
      <class>LusasContourColors.ContourColorsModule</class>
    </assembly>
    <identity>
      <friendlyname>Contour Colours</friendlyname>
      <description>Scientific contour colour themes.</description>
    </identity>
    <keys />
    <verified />
    <options>
      <kid>1</kid>
    </options>
  </module>
</modules>
